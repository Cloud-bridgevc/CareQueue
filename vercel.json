{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "vercel-static",
  "buildCommand": "mkdir -p vercel-static && printf 'User-agent: *\\nAllow: /\\n' > vercel-static/robots.txt",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "includeFiles": "{public,shared,data,server,integrations}/**"
    }
  }
}
